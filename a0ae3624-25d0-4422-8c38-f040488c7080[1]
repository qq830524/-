<!DOCTYPE html><html lang="zh-TW"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>命主 · 個性 × 感情</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;700&family=Noto+Sans+TC:wght@300;400;500&family=Cormorant+Garamond:ital,wght@0,700;1,400&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{--ink:#1e1b18;--cream:#faf7f2;--parchment:#f4efe6;--gold:#a07830;--gold-l:#c9a55a;--border:#e4ddd4;--gray:#8c857d;--white:#fff;}
body{font-family:'Noto Sans TC',sans-serif;background:var(--cream);color:var(--ink);}
.cover{background:linear-gradient(150deg,#1a1410 0%,#2c1e16 55%,#3a2820 100%);padding:52px 36px 44px;position:relative;overflow:hidden;}
.cover::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 15% 30%,rgba(160,120,48,.15) 0%,transparent 60%),radial-gradient(ellipse at 85% 75%,rgba(138,74,90,.1) 0%,transparent 60%);pointer-events:none;}
.ci{max-width:680px;margin:0 auto;position:relative;}
.eyebrow{font-size:10px;letter-spacing:3px;color:rgba(201,165,90,.7);text-transform:uppercase;margin-bottom:16px;}
.cname{font-family:'Cormorant Garamond',serif;font-size:clamp(36px,6vw,54px);color:#f5f0e8;font-weight:700;line-height:1.1;margin-bottom:6px;}
.csub{font-size:12px;color:rgba(245,240,232,.45);letter-spacing:1px;margin-bottom:26px;}
.ctags{display:flex;gap:7px;flex-wrap:wrap;}
.ctag{padding:4px 13px;border-radius:20px;font-size:11px;border:1px solid rgba(245,240,232,.15);color:rgba(245,240,232,.6);}
.ctag.g{border-color:rgba(201,165,90,.4);color:var(--gold-l);}
.ctag.r{border-color:rgba(180,100,120,.4);color:#c08090;}
.body{max-width:680px;margin:0 auto;padding:36px 20px 60px;}
.ov{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:32px;}
@media(max-width:500px){.ov{grid-template-columns:1fr;}}
.oc{background:var(--white);border:1px solid var(--border);border-radius:8px;padding:16px 18px;}
.oc-lbl{font-size:10px;letter-spacing:2px;text-transform:uppercase;font-weight:600;margin-bottom:10px;}
.oc-lbl.zw{color:var(--gold);} .oc-lbl.hd{color:#5a3f7a;}
.oc-row{display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px;gap:8px;}
.oc-k{color:var(--gray);flex-shrink:0;} .oc-v{font-weight:500;text-align:right;}
.tags{display:flex;flex-wrap:wrap;gap:4px;margin-top:7px;}
.tag{padding:3px 8px;border-radius:12px;font-size:11px;font-weight:500;}
.t-lu{background:#d4622a;color:#fff;} .t-quan{background:#2a6aad;color:#fff;}
.t-ke{background:#2a8a5a;color:#fff;} .t-ji{background:#8a2a3a;color:#fff;}
.t-fu{background:#f0ece4;color:#6a5a48;border:1px solid #ddd;} .t-xiong{background:#fdf0ee;color:#8a3a2a;border:1px solid #e8c0c0;}
.t-def{background:var(--ink);color:#fff;} .t-undef{background:var(--parchment);color:var(--gray);border:1px solid var(--border);}
.imgs{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:32px;}
@media(max-width:500px){.imgs{grid-template-columns:1fr;}}
.img-card{background:var(--white);border:1px solid var(--border);border-radius:8px;overflow:hidden;}
.img-lbl{padding:9px 14px;font-size:10px;letter-spacing:2px;text-transform:uppercase;font-weight:600;border-bottom:1px solid var(--border);}
.img-lbl.zw{color:var(--gold);} .img-lbl.hd{color:#5a3f7a;}
.img-card img{width:100%;display:block;}
.sec{margin-bottom:32px;}
.sec-hd{display:flex;align-items:center;gap:10px;margin-bottom:16px;padding-bottom:11px;border-bottom:1px solid var(--border);}
.sec-num{width:26px;height:26px;background:var(--ink);color:var(--cream);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;flex-shrink:0;}
.sec-title{font-family:'Noto Serif TC',serif;font-size:19px;font-weight:600;}
.bl{border-radius:6px;padding:16px 18px;margin-bottom:10px;}
.bl-lbl{font-size:10px;letter-spacing:2px;text-transform:uppercase;font-weight:600;margin-bottom:9px;}
.bl p{font-size:13.5px;line-height:1.9;font-weight:300;}
.bl-zw{background:var(--white);border:1px solid var(--border);} .bl-zw .bl-lbl{color:var(--gold);}
.bl-hd{background:#f8f5fc;border:1px solid #e0d8ec;} .bl-hd .bl-lbl{color:#5a3f7a;}
.bl-int{background:linear-gradient(135deg,#1e1a16,#2c2018);} .bl-int .bl-lbl{color:var(--gold-l);} .bl-int p{color:rgba(245,240,232,.75);}
.div{text-align:center;color:var(--border);letter-spacing:8px;font-size:14px;margin:24px 0;}
.clos{background:var(--parchment);border:1px solid var(--border);border-radius:8px;padding:20px;margin-bottom:24px;}
.clos p{font-size:13.5px;line-height:1.95;color:#5a4e3c;font-weight:300;}
.foot{text-align:center;padding:18px;font-size:11.5px;color:var(--gray);border-top:1px solid var(--border);}

/* MIC */
.f-with-mic { position: relative; }
.f-with-mic textarea { padding-right: 44px; }
.mic-btn {
  position: absolute; right: 8px; top: 8px;
  width: 30px; height: 30px; border-radius: 50%;
  border: none; background: var(--light);
  color: var(--gray); font-size: 14px;
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: all 0.15s; flex-shrink: 0;
}
.mic-btn:hover { background: var(--gold-bg); color: var(--gold); }
.mic-btn.recording {
  background: #fee2e2; color: #dc2626;
  animation: pulse 1s infinite;
}
@keyframes pulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(220,38,38,0.3); }
  50% { box-shadow: 0 0 0 6px rgba(220,38,38,0); }
}
.mic-toast {
  position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
  background: #1e1b18; color: #fff; padding: 8px 18px;
  border-radius: 20px; font-size: 12px; font-weight: 500;
  opacity: 0; transition: opacity 0.25s; pointer-events: none; z-index: 9999;
  white-space: nowrap;
}
.mic-toast.show { opacity: 1; }
</style></head><body>
<div class="cover"><div class="ci">
  <div class="eyebrow">命盤整合解析 · 個性 × 感情</div>
  <div class="cname">命主</div>
  <div class="csub">生命資訊</div>
  <div class="ctags">
    
    
    <span class="ctag r">個性 × 感情</span>
  </div>
</div></div>
<div class="body">
<div class="ov">
  <div class="oc">
    <div class="oc-lbl zw">☆ 紫微命盤</div>
    
    
    
  </div>
  <div class="oc">
    <div class="oc-lbl hd">◎ 人類圖</div>
    
    
    
    
    <div style="margin-top:5px;font-size:10px;color:var(--gray);margin-bottom:4px;">未定義中心</div><div class="tags"><span class="tag t-undef">🧠 頭腦中心</span><span class="tag t-undef">👁 邏輯中心</span><span class="tag t-undef">🗣 喉嚨中心</span><span class="tag t-undef">♡ G中心</span><span class="tag t-undef">💪 意志力中心</span><span class="tag t-undef">🌊 情緒中心</span><span class="tag t-undef">⚡ 薦骨中心</span><span class="tag t-undef">🛡 直覺中心</span><span class="tag t-undef">🌿 根部中心</span></div>
  </div>
</div>




<div class="foot">紫微斗數 × 人類圖 整合解析　｜　</div>
</div><div class="mic-toast" id="mic-toast"></div>
</body></html>
